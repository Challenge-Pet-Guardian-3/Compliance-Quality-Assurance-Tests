# Configurações do Azure DevOps
AZURE_DEVOPS_ORG=PetGuardian
AZURE_DEVOPS_PROJECT=Pet-Guardian-Sprint-3

# Personal Access Token (PAT)
# Como gerar: Acesse dev.azure.com/PetGuardian -> Canto superior direito (ícone de perfil) -> Personal access tokens
# Crie um token com permissão "Work Items (Read & Write)".
# Se deixar em branco, o script tentará obter as credenciais da sua sessão ativa no Azure CLI (az login).
AZURE_DEVOPS_PAT=
