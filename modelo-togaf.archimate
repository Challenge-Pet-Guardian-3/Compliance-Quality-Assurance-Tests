  <folder name="Motivation" id="id-9eed1c717eb34032b0c67456eb255539" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Tutor" id="id-404e6cd9ac854b61aa0f8d45e03f8b35"/>
    <element xsi:type="archimate:Stakeholder" name="Cuidador Familiar" id="id-215d67be0a6844f4853f4d98e4723916"/>
    <element xsi:type="archimate:Stakeholder" name="Veterinário" id="id-bd4781f06bfd4abb8927e28316a6193c"/>
    <element xsi:type="archimate:Stakeholder" name="Equipe de Desenvolvimento" id="id-6147e0465d13482a9b7d8cc59954ee0c"/>
    <element xsi:type="archimate:Stakeholder" name="FIAP" id="id-36d31c2a911a4601a7a2a42776b4999b"/>
    <element xsi:type="archimate:Driver" name="Falha no Cuidado Preventivo" id="id-0d88626762a54c2eaaa35e8f8ab0d7cf"/>
    <element xsi:type="archimate:Driver" name="Cuidado somente nas emergências" id="id-ca61c39d38c04b2f9a4ec989572c3c96"/>
    <element xsi:type="archimate:Driver" name="Descentralização de Histórico" id="id-82c1801470474943941f787ab7f72cfa"/>
    <element xsi:type="archimate:Driver" name="Falhas na Comunicação Familiar" id="id-4251a2de327741e7b446959f14d227fa"/>
    <element xsi:type="archimate:Assessment" name="Alto Índice de Negligência (>50%)" id="id-46824a9ea6cc4fd69420ac6479af1ed8"/>
    <element xsi:type="archimate:Assessment" name="Ausência de Soluções Integradas em outras plataformas" id="id-c772ec50420741cf936d4e9ff8e73843"/>
    <element xsi:type="archimate:Assessment" name="Dependência de Conexão Contínua" id="id-4424438fb1704f16bd041c97f8750235"/>
    <element xsi:type="archimate:Goal" name="Centralizar a gestão da saúde" id="id-a133df7bc0c84d77a42d78f24271503b"/>
    <element xsi:type="archimate:Goal" name="Engajar através da gamificação" id="id-664e7761a1be44fda486115af889bd0b"/>
    <element xsi:type="archimate:Goal" name="Sincronização familiar" id="id-8166b62531174deba52b04e9868d5f06"/>
    <element xsi:type="archimate:Goal" name="Diminuir o cuidado reativo" id="id-385df2a90e3842c0a3a86c9913d62e28"/>
    <element xsi:type="archimate:Assessment" name="Ineficiência do Controle Manual" id="id-0f713bbec6574508ac46b1133bbfd11f"/>
    <element xsi:type="archimate:Principle" name="Offline-first" id="id-1b7ca47442f742ee9b0e40f0308b4fed">
      <documentation> Persistência local garantindo alta fluidez e disponibilidade total dos dados sem necessidade de conectividade. </documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Segurança e Privacidade de Dados" id="id-b454a6784dac4cffa73c91d951d64f66">
      <documentation>Controles rigorosos e conformidade legal na proteção de dados, desde o armazenamento local até a futura integração em nuvem</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Gamificação com propósito" id="id-03bba7f1ff2641f99f6b41b541b71996">
      <documentation>Mecânicas de incentivo em formato de jogo voltadas exclusivamente para o reforço de comportamentos de cuidado preventivo.</documentation>
    </element>
    <element xsi:type="archimate:Principle" name="Experiência centrada no cuidador" id="id-430e720fad8a46d8b04ff197c20ba9ce">
      <documentation>Interface &quot;Direto ao Ponto&quot; e Mobile-First, desenhada para registrar tarefas em poucos cliques e sem burocracia.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Grupos familiares (convite, mural colaborativo, chat compartilhado)." id="id-1cd166a1c66e4f9eb16d8838e00f924a"/>
    <element xsi:type="archimate:Requirement" name="Repositório centralizado (ficha clínica completa por pet, contatos para os veterinários)." id="id-9539d81e70f3417c9bbd4d56485b48b8"/>
    <element xsi:type="archimate:Requirement" name="Gestão de tarefas diárias personalizadas (criação, conclusão e feedback visual)." id="id-4622b525226c40b5a3e9c42fa77970f5"/>
    <element xsi:type="archimate:Requirement" name="Sistema de Gamificação (XP, ofensivas/streaks, ranking familiar)." id="id-36268b9ad41b47c593e509c41ddf7bbc"/>
    <element xsi:type="archimate:Requirement" name=" Guia Educativo (artigos sobre bem-estar e saúde preventiva)." id="id-de03723d4692433fafadde9cd4b13cbf"/>
    <element xsi:type="archimate:Requirement" name="Perfil e Suporte (gestão de conta, FAQ, formulário de contato)." id="id-658c91838a084581bb98020b47f723c0"/>
    <element xsi:type="archimate:Requirement" name="Não Funcional: Disponibilidade Offline" id="id-e60e330cce714f3cbd210d5f0a0c4070">
      <documentation>Persistência local garantida via AsyncStorage, com estrutura desenhada para sincronização futura em nuvem.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Não Funcional:Alta Performance" id="id-17084c82286a40559338a3cc066872a6">
      <documentation>Tempo médio de resposta para a conclusão de tarefas e carregamento de telas sempre abaixo de 2 segundos.</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Não Funcional: Usabilidade e Acessibilidade" id="id-5909c3e8515a42d6ba32b2deb0b0a183">
      <documentation>Interface intuitiva e Mobile-First, com navegação simples, sem burocracia e acessível para todas as idades.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Plataforma: Exclusivamente Mobile (feita no React Native/ Expo)" id="id-6c02dbb747fc45498c102a23d3251218"/>
    <element xsi:type="archimate:Constraint" name="Persistência: Estratégia Offline-first " id="id-ee3b9f8ec4fa42ceafc79ad23ebd85fb">
      <documentation>Estratégia Offline-first com armazenamento em AsyncStorage limitado ao escopo inicial do MVP (Sprints 1 e 2), evoluindo para a arquitetura com integração a back-end em nuvem e banco de dados Oracle a partir da Sprint 3.</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="Escopo: Prazo definido pelas sprints FIAP (S1, S3 e S4)" id="id-5d6e3ff681ba466caa0a780c79be3026"/>
    <element xsi:type="archimate:Constraint" name="Constraint" id="id-1a18e5562ff94dee9e23ee26794980a2"/>
    <element xsi:type="archimate:Constraint" name="Recursos: Equipe acadêmica de 5 pessoas e sem uso de APIs pagas de terceiros." id="id-d0eab6c8423b4e24b5c96b7428572faa"/>
  </folder>
