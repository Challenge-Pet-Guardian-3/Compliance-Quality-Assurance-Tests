<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="(new model)" id="id-621dd2febaf444fca5331a98f1e323c5" version="5.0.0">
  <folder name="Strategy" id="id-7990a937ade54491969429a3a8fa5979" type="strategy"/>
  <folder name="Business" id="id-3cec1adcc4224a57adf3b769003d932d" type="business">
    <element xsi:type="archimate:BusinessActor" name="Tutor" id="id-d6cd7ddfb61c4d8c9d0bf4c873349eb9"/>
    <element xsi:type="archimate:BusinessActor" name="Cuidador Familiar" id="id-2dce64fdba7346c4a469f50b58b852f8"/>
    <element xsi:type="archimate:BusinessRole" name="Administrador da Família (Tutor)" id="id-201272df60d743dcb90c2c84df3048c3"/>
    <element xsi:type="archimate:BusinessRole" name="Cuidador Colaborativo (Familiar)" id="id-64429330bf884ecd8c61bca43031d1ff"/>
    <element xsi:type="archimate:BusinessInterface" name="Aplicação Mobile PetGuardian (React Native / Expo)." id="id-b4e106f114914e0abfffab250ff181b0"/>
    <element xsi:type="archimate:BusinessProcess" name="Gerenciar Ficha Clínica e Perfis dos Pets" id="id-25c985bbaeb94e3dad44f0544e7bfcb7">
      <documentation>É o fluxo de entrada de dados e consultas. Representa o tutor ativamente criando o avatar, digitando os dados de vacinas e abrindo o Modo Consulta na aba Meu Pet.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Sincronizar Rotina e Tarefas Diárias" id="id-8fd37cd76edd4716bce085fd20704b15">
      <documentation>É o fluxo operacional core do PetGuardian. Representa o usuário criando um lembrete e depois marcando o &quot;check&quot; na tela, além do sistema salvando isso na memória (preparando o terreno para as próximas sprints).</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Engajar Tutores via Gamificação" id="id-36aba51aca4d44aebfda9a1168354773">
      <documentation>É o fluxo de recompensa do sistema. Representa a engrenagem que roda logo após a conclusão da tarefa, onde o app calcula a matemática do XP, atualiza a ofensiva e mexe na posição do ranking.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Coordenação de Rotina e Colaboração" id="id-40c9b0adf8844db4bf6f41d017bcb0a1">
      <documentation>Gerencia as tarefas diárias e a comunicação familiar, organizando a listagem da aba Home e o mural de recados da aba Family Pet</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Gestão de Histórico Clínico" id="id-e996a1d6e9ba4c9fb572fade159d5354">
      <documentation>Concentra dados vitais, agenda de contatos veterinários e registros médicos, acessíveis na aba Meu Pet e otimizados para visualização rápida diretamente no dispositivo do tutor através do Modo Consulta</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Educação em Saúde Preventiva" id="id-9392a66e3d134e0390eff77d63f408af">
      <documentation>Centraliza artigos educativos e guias de cuidados disponibilizados na aba Dicas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Engajamento e Evolução do Tutor" id="id-e627f551244b4bce9107e0b557f8b276">
      <documentation>Gerencia o cálculo de XP, manutenção de streaks e definição do ranking exibidos na aba Perfil</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Administração de Conta e Suporte" id="id-89d5a27fe27142b9b8ddbc0d2c4834da">
      <documentation>Gerencia segurança, credenciais de acesso, FAQ e canais de feedback técnico, acessíveis na aba Perfil.&#xD;
</documentation>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="Tarefa Registrada pelo Usuário" id="id-f18b3ff8ec674d0e9300bec40338c979"/>
